{
  "version": "2.0",
  "envId": "{{envId}}",
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/schema/latest.json",
  "framework": {
    "name": "ai-qianlv",
    "plugins": {
      "node": {
        "use": "@cloudbase/framework-plugin-node",
        "inputs": {
          "name": "ai-qianlv",
          "entry": "server.js",
          "path": "/dist/standalone",
          "buildCommand": "npm install && npm run build",
          "runCommand": "node server.js",
          "memory": 512,
          "timeout": 30,
          "envVariables": {
            "NODE_ENV": "production",
            "PORT": 80
          }
        }
      }
    }
  }
}
