# Canonical trusted origin used only for Open Graph / X metadata.
# Set the deployed origin in Sites environment variables after provisioning.
SITE_URL=http://localhost:3000

# Browser-side Baidu Maps JavaScript API 4.0 key. Restrict the key with a
# domain whitelist in the Baidu Maps console. Leave empty to use the built-in
# interactive guide preview while keeping Baidu URI route links available.
VITE_BAIDU_MAP_AK=
